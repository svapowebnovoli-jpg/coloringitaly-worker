    {
      "id": "SMK-10",
      "name": "master_orchestrator_baseline_output",
      "scope": "agent",
      "files_under_test": [
        "10_master_orchestrator_v3.json",
        "01_shared_system_rules_v3.json",
        "02_standard_terminology_v3.json"
      ],
      "dependencies": ["SMK-00"],
      "sample_input": {
        "topic": "Italy through villages, roads, local food rituals, and heritage landscapes",
        "country_scope": {
          "mode": "fixed",
          "countries": ["Italy"]
        },
        "constraints": {
          "must_include": ["villages", "routes", "food culture"],
          "must_avoid": ["generic tourist lists", "random monuments"],
          "audience": ["adults", "heritage lovers", "travel-oriented printable buyers"],
          "formats": ["coloring_book", "illustrated_map", "recipe_cards"],
          "style_notes": ["editorial", "heritage", "line-art friendly"],
          "commercial_goal": "Build 3 coherent collections with cross-sell potential"
        },
        "brand_context": {
          "brand_name": "BagarreBazaar",
          "sub_brand": "Ink & Roads",
          "positioning": "Narrative editorial digital products rooted in the identity of places",
          "visual_dna": ["line art", "editorial tone", "country specificity"]
        },
        "output_goal": {
          "target_collections": 3,
          "target_product_briefs_per_collection": 3,
          "depth": "standard"
        },
        "revision_round": 1
      },
      "expected_output_fields": [
        "story_spine",
        "country_decision",
        "priority_lenses",
        "product_family_matrix",
        "delegation_schema",
        "global_exclusions",
        "validation_questions",
        "handoff_readiness",
        "revision_round",
        "revision_reason",
        "applied_adjustments",
        "remaining_open_questions"
      ],
      "pass_criteria": [
        "One full output contract only",
        "story_spine.core_thesis is non-empty",
        "2 to 4 priority lenses are selected",
        "handoff_readiness.status is ready or needs_revision",
        "global_exclusions contains at least 2 explicit exclusions"
      ],
      "fail_criteria": [
        "Simplified contract returned instead of full contract",
        "Missing story_spine.core_thesis",
        "No validation_questions",
        "No handoff_readiness object"
      ],
      "blocking_errors": ["MST-001", "MST-002"]
    },
    {
      "id": "SMK-11",
      "name": "pattern_validation_approve_path",
      "scope": "agent",
      "files_under_test": [
        "11_pattern_validation_agent_v3.json",
        "03_revision_protocol_v3.json"
      ],
      "dependencies": ["SMK-10"],
      "sample_input_reference": "Use the successful output of SMK-10 with handoff_readiness.status=ready",
      "expected_output_fields": [
        "validation_report",
        "suggested_prioritization",
        "red_flags",
        "suggested_exclusions",
        "rehoming_ideas",
        "recommended_adjustments",
        "handoff_decision",
        "handoff_notes",
        "needs_human_review"
      ],
      "pass_criteria": [
        "validation_report.narrative_coherence is between 1 and 10",
        "handoff_decision is approve when the pattern is coherent",
        "handoff_notes includes downstream notes",
        "needs_human_review is false on first successful pass"
      ],
      "fail_criteria": [
        "Missing handoff_decision",
        "Missing recommended_adjustments",
        "Narrative coherence outside 1-10 range"
      ],
      "blocking_errors": ["PAT-001"]
    },
    {
      "id": "SMK-12",
      "name": "pattern_validation_revise_loop",
      "scope": "protocol",
      "files_under_test": [
        "11_pattern_validation_agent_v3.json",
        "10_master_orchestrator_v3.json",
        "03_revision_protocol_v3.json"
      ],
      "dependencies": ["SMK-10"],
      "sample_input": {
        "story_spine": {
          "core_thesis": "Italy is beautiful",
          "narrative_direction": "general travel",
          "editorial_angle": "generic tourism"
        },
        "country_decision": {"selected_countries": ["Italy"]},
        "priority_lenses": ["Built Place"],
        "product_family_matrix": ["coloring_book"],
        "global_exclusions": [],
        "constraints": {
          "audience": ["all"],
          "formats": ["all"],
          "commercial_goal": "sell something"
        },
        "revision_round": 1
      },
      "expected_output_or_state": [
        "Pattern returns handoff_decision=revise",
        "Master produces revision_round=2 output",
        "Second validation pass occurs once",
        "If still revise on round 2, needs_human_review=true and loop stops"
      ],
      "pass_criteria": [
        "Exactly one automated retry after first revise",
        "No infinite loop",
        "Second revise escalates to human review"
      ],
      "fail_criteria": [
        "No clear revise handoff back to Master",
        "More than 2 automated rounds",
        "No escalation after second revise"
      ],
      "blocking_errors": ["REV-001", "REV-002"]
    },
    {
      "id": "SMK-13",
      "name": "country_research_verified_mode",
