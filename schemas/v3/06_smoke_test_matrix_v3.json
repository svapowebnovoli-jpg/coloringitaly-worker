        "02_standard_terminology_v3.json"
      ],
      "dependencies": ["SMK-11"],
      "sample_input": {
        "country": "Italy",
        "story_spine": {
          "core_thesis": "Italy told through lived landscapes, village routes, and table rituals",
          "narrative_direction": "place identity through daily material culture"
        },
        "priority_lenses": ["Built Place", "Routes & Maps", "Table & Food"],
        "constraints": {
          "must_include": ["villages", "roads", "markets"],
          "must_avoid": ["generic bucket-list attractions"],
          "audience": ["adults", "travel-inspired printable buyers"]
        },
        "research_depth": "standard",
        "research_mode": "verified_web"
      },
      "expected_output_fields": [
        "country_profile",
        "lens_findings",
        "territorial_inventory",
        "seasonality_and_timing",
        "research_gaps",
        "source_refs",
        "handoff_ready_clusters",
        "needs_human_review"
      ],
      "pass_criteria": [
        "source_refs contains only verified or explicitly low-confidence sources",
        "territorial_inventory items use needs_verification where needed",
        "lens_findings use hero_subjects and hero_elements, not synonyms",
        "handoff_ready_clusters is non-empty"
      ],
      "fail_criteria": [
        "Invented URLs",
        "No source confidence signaling",
        "No territorial inventory coverage across relevant lenses"
      ],
      "blocking_errors": ["CTR-001", "CTR-002"]
    },
